---js
{
	layout: "layouts/page.njk",
	title: "Blog",
	description: "Writing by Ben Farrell on design, code, and creative technology.",
	blogIndex: true,
	pagination: {
		data: "collections.posts",
		reverse: true,
		alias: "postslist",
		size: 10,
		before: function(data) {
			return this.filterByCommonCategories(data, ['blog']);
		}
	},
	permalink: "{{ page.fileSlug }}/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
}
---

<div class="blog-index">
	{% include "postslist.njk" %}
	<nav aria-label="Blog pages" class="blog-pagination">
		<div class="blog-pagination-group">
			{% if page.url != pagination.href.first %}<a href="{{ pagination.href.first }}">First</a>{% else %}<span class="pagination-disabled" aria-disabled="true">First</span>{% endif %}
			{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev">Newer</a>{% else %}<span class="pagination-disabled" aria-disabled="true">Newer</span>{% endif %}
		</div>
		<span class="blog-page-status" aria-current="page">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
		<div class="blog-pagination-group">
			{% if pagination.href.next %}<a href="{{ pagination.href.next }}" rel="next">Older</a>{% else %}<span class="pagination-disabled" aria-disabled="true">Older</span>{% endif %}
			{% if page.url != pagination.href.last %}<a href="{{ pagination.href.last }}">Last</a>{% else %}<span class="pagination-disabled" aria-disabled="true">Last</span>{% endif %}
		</div>
	</nav>
</div>
