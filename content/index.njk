  - title: "Intro to VR"
    context: "Speaking & teaching"
    description: "A talk about Adobe's work in virtual reality. Named a top-10 session at Adobe Tech Summit in 2017."
    url: "/speaking-engagements/#intro-to-vr"
    image: "/images/work/intro-to-vr.webp"
