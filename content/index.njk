---

<div class="portfolio-home">
	<div class="home-profile">
		<div class="home-portrait">
			<img src="/images/benvector.svg" alt="An illustrated portrait of Ben" width="289" height="392" />
		</div>
		<h1>Design Engineer<span class="home-title-dot">.</span></h1>
		<section id="about" class="home-bio" aria-label="About Ben">
			<p>I'm Ben Farrell, a Design Engineer at <a href="https://adobe.design">Adobe</a>.</p>
			<p>Mostly web, sometimes installations and hardware, with <a href="/awards/">the occasional award</a> along the way. Lately, music and making physical things with digital tech.</p>
			<p>I also wrote <a href="https://www.manning.com/books/web-components-in-action">Web Components in Action</a>.</p>
		</section>
		<div id="contact" class="home-contact">
			<a href="mailto:{{ metadata.author.email }}">{{ metadata.author.email }}</a>
			<div class="home-profile-links">
				<a href="/resume/">R&eacute;sum&eacute;</a>
				<a href="https://github.com/bengfarrell">GitHub</a>
				<a href="https://www.linkedin.com/in/bfarrellforever/">LinkedIn</a>
			</div>
		</div>
	</div>

	<div class="home-index">
		<section id="work" aria-labelledby="work-heading">
			<h2 id="work-heading" class="home-section-label">Selected work</h2>
			<div class="home-projects">
				{% for project in selectedWork %}
				<article class="home-project">
					<a class="home-project-image" href="{{ project.url }}" aria-label="{{ project.title }}">
						<img src="{{ project.image }}" alt="{{ project.alt }}" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" loading="lazy" />
					</a>
					<div class="home-project-copy">
						<p class="home-project-context">{{ project.context }}</p>
						<h3><a href="{{ project.url }}">{{ project.title }}</a></h3>
						<p class="home-project-description">{{ project.description }}</p>
						<p class="home-category-link"><a href="{{ project.moreUrl }}">{{ project.moreLabel }} &rarr;</a></p>
					</div>
				</article>
				{% endfor %}
			</div>
		</section>

		{% set recentPosts = collections.posts | filterByCommonCategories("blog") | reverse | head(3) %}
		{% if recentPosts.length %}
		<section class="home-writing" aria-labelledby="writing-heading">
			<div class="home-section-heading">
				<h2 id="writing-heading" class="home-section-label">Recent writing</h2>
				<a href="/blog/">All posts</a>
			</div>
			<ul class="home-posts">
				{% for post in recentPosts %}
				<li>
					<a href="{{ post.url }}">
						<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLL yyyy") }}</time>
						<span>{{ post.data.title }}</span>
					</a>
				</li>
				{% endfor %}
			</ul>
		</section>
		{% endif %}
	</div>
</div>
